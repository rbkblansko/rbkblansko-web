---
import MainLayout from '../layouts/MainLayout.astro';
import { getPath } from '../utils/paths';
---

<MainLayout title="Program">
  <div class="max-w-5xl mx-auto">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Program</h1>
      <div class="w-24 h-1.5 bg-brand rounded-full mb-8"></div>
      <p class="text-xl text-gray-600">Rozpis tréninků a nadcházejících akcí.</p>
    </div>

    <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Rozpis tréninků: 2025/2026</h2>
      <p class="text-gray-600 mb-10">Pravidelné tréninky probíhají podle následujícího rozpisu:</p>

      <div class="space-y-10">
        <section class="border-b border-gray-200 pb-8">
          <h3 class="flex items-center gap-4 text-3xl font-extrabold text-gray-900 mb-4">
            <img src={getPath('/images/lampion.png')} alt="" class="w-8 h-8 object-contain" />
            Pondělí / Středa
          </h3>
          <p class="font-bold text-gray-900 mb-4">Stadion ASK Blansko</p>
          <p class="font-bold mb-2">Dorost</p>
          <ul class="list-disc pl-6 space-y-1 text-gray-700">
            <li>individuální atletický dráhový trénink dle plánu</li>
          </ul>
        </section>

        <section class="border-b border-gray-200 pb-8">
          <h3 class="flex items-center gap-4 text-3xl font-extrabold text-gray-900 mb-4">
            <img src={getPath('/images/lampion.png')} alt="" class="w-8 h-8 object-contain" />
            Úterý
          </h3>
          <p class="font-bold text-gray-900 mb-2">
  Sportovní ostrov Ludvíka Daňka a okolí
</p>

<p class="text-orange-600 font-semibold mb-4">
  Začátek tréninku v 17:45
</p>
          <p class="font-bold mb-2">Všichni</p>
          <ul class="list-disc pl-6 space-y-1 text-gray-700">
            <li>trailový běh</li>
            <li>běh ve volném terénu</li>
            <li>atletický dráhový trénink</li>
            <li>cvičení s překážkami</li>
            <li>cvičení síly, rychlosti a obratnosti</li>
            <li>plyometrie</li>
          </ul>
        </section>

        <section class="border-b border-gray-200 pb-8">
          <h3 class="flex items-center gap-4 text-3xl font-extrabold text-gray-900 mb-8">
            <img src={getPath('/images/lampion.png')} alt="" class="w-8 h-8 object-contain" />
            Čtvrtek
          </h3>

          <div class="mb-10">
            <h4 class="flex items-center gap-3 text-2xl font-extrabold text-orange-600 mb-2">
              <img src={getPath('/images/lampion.png')} alt="" class="w-7 h-7 object-contain" />
              Listopad – březen
            </h4>
            <p class="font-bold text-gray-900 mb-6">Tělocvična ZŠ Salmova</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="border-l-2 border-orange-500 pl-5">
                <h5 class="text-xl font-extrabold mb-3">17:30</h5>
                <ul class="list-disc pl-5 text-gray-700">
                  <li>mapová teorie</li>
                </ul>
              </div>

              <div class="border-l-2 border-orange-500 pl-5">
                <h5 class="text-xl font-extrabold mb-3">18:00</h5>
                <p class="font-bold mb-2">Žactvo</p>
                <ul class="list-disc pl-5 text-gray-700 mb-4">
                  <li>pohybové aktivity v tělocvičně</li>
                  <li>rozvoj pohybových schopností</li>
                  <li>nácvik běhu</li>
                  <li>hry</li>
                </ul>

                <p class="font-bold mb-2">Dorost</p>
                <ul class="list-disc pl-5 text-gray-700">
                  <li>výběh</li>
                  <li>cvičení síly, rychlosti a obratnosti</li>
                  <li>plyometrie</li>
                </ul>
              </div>

              <div class="border-l-2 border-orange-500 pl-5">
                <h5 class="text-xl font-extrabold mb-3">19:00</h5>
                <p class="font-bold mb-2">Dorost, dospělí</p>
                <ul class="list-disc pl-5 text-gray-700">
                  <li>posilování</li>
                </ul>
              </div>
            </div>
          </div>

          <div>
            <h4 class="flex items-center gap-3 text-2xl font-extrabold text-orange-600 mb-2">
              <img src={getPath('/images/lampion.png')} alt="" class="w-7 h-7 object-contain" />
              Duben – říjen
            </h4>
            <p class="font-bold text-gray-900 mb-4">Lesy v okolí Blanska</p>
            <p class="font-bold mb-2">Všichni</p>
            <ul class="list-disc pl-6 space-y-1 text-gray-700">
              <li>mapový trénink</li>
              <li>nácvik práce s buzolou</li>
              <li>nácvik mapových a navigačních technik</li>
              <li>běh volným terénem</li>
            </ul>
          </div>
        </section>

        <section>
          <h3 class="flex items-center gap-4 text-3xl font-extrabold text-gray-900 mb-4">
            <img src={getPath('/images/lampion.png')} alt="" class="w-8 h-8 object-contain" />
            Pátek / Neděle
          </h3>
          <p class="font-bold mb-2">Všichni</p>
          <ul class="list-disc pl-6 space-y-1 text-gray-700">
            <li>noční orientační běh</li>
            <li>mapový trénink</li>
            <li>nácvik mapových a navigačních technik</li>
            <li>běh volným terénem</li>
          </ul>
        </section>
      </div>

      <p class="mt-12 pt-8 border-t border-gray-200 text-gray-700">
        Podrobný rozpis dle kalendáře v <span class="text-orange-600 font-semibold">Přihlašovacím systému</span>.
      </p>
    </section>
  </div>
</MainLayout>