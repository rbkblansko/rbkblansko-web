---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { getPath } from '../../utils/paths';

export async function getStaticPaths() {
  const newsEntries = await getCollection('novinky');
  return newsEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<MainLayout title={entry.data.title}>
  <article class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm p-8 md:p-12 border border-gray-100">
    <div class="mb-8 border-b border-gray-100 pb-8">
      <a href={getPath('/novinky')} class="inline-flex items-center text-brand font-medium hover:text-brand-dark mb-6 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Zpět na všechny novinky
      </a>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-4 leading-tight">{entry.data.title}</h1>
      <time class="text-gray-500 font-medium flex items-center" datetime={entry.data.date.toISOString()}>
        <svg class="w-5 h-5 mr-2 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {entry.data.date.toLocaleDateString('cs-CZ')}
      </time>
    </div>
    <div class="prose prose-lg prose-gray prose-a:text-brand max-w-none">
      <Content />
    </div>
  </article>
</MainLayout>
