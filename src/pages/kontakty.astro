---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Kontakty">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Kontakty</h1>
      <div class="w-24 h-1.5 bg-brand mx-auto rounded-full"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow group">
        <div class="bg-brand-light p-3 rounded-full text-brand shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Napište nám</h3>
          <p class="text-gray-600 mb-2">Pro jakékoliv dotazy nás kontaktujte emailem.</p>
          <a href="mailto:jaroslavjalovy@email.cz" class="text-brand font-semibold hover:text-brand-dark transition-colors">jaroslavjalovy@email.cz</a>
        </div>
      </div>
      
      <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow group">
        <div class="bg-brand-light p-3 rounded-full text-brand shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Zavolejte nám</h3>
          <p class="text-gray-600 mb-2">Jsme k dispozici v pracovní dny od 8 do 16 hodin.</p>
          <p class="text-brand font-semibold">+420 737 241 632</p>
        </div>
      </div>
      
      <div class="bg-white rounded-2xl shadow-sm p-8 border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow group">
        <div class="bg-brand-light p-3 rounded-full text-brand shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Sledujte nás</h3>
          <p class="text-gray-600 mb-2">Sledujte naše nejnovější aktivity na Instagramu.</p>
          <a href="https://www.instagram.com/rbk_blansko?igsh=NDgweXUzNjE5Z296" target="_blank" rel="noopener noreferrer" class="text-brand font-semibold hover:text-brand-dark transition-colors">@rbk_blansko</a>
        </div>
      </div>
    </div>
      </div>

    <section class="mt-16">
      <div class="bg-gradient-to-r from-brand to-brand-dark text-white rounded-3xl p-10 text-center shadow-xl">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
          PŘIJĎ ZKUSIT ORIENTAČNÍ BĚH DO MORAVSKÉHO KRASU
        </h2>

        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto mb-8">
          Hledáš sport, který spojuje běh, přírodu a dobrodružství?
          Přijď si zdarma vyzkoušet trénink RBK Blansko.
          Rádi mezi sebou přivítáme děti, mládež i dospělé.
        </p>

        <a
          href="mailto:jaroslavjalovy@email.cz"
          class="inline-block bg-white text-brand font-bold px-8 py-4 rounded-full hover:scale-105 transition-transform shadow-lg"
        >
          Přihlásit se na první trénink
        </a>
      </div>
    </section>
  </div>
</MainLayout>
