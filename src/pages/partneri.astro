---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Partneři">
  <div class="max-w-6xl mx-auto">

    <div class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">
        Partneři
      </h1>
      <div class="w-24 h-1.5 bg-brand mx-auto rounded-full"></div>

      <p class="text-xl text-gray-600 mt-8 max-w-3xl mx-auto">
        Děkujeme všem partnerům a podporovatelům,
        kteří pomáhají rozvíjet orientační běh v Blansku.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

  <a
    href="https://www.ceskyorientak.cz/"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-center"
  >
    <div class="h-20 flex items-center justify-center">
      <img
        src="/images/partneri/cesky-orientak.png"
        alt="Český orienťák"
        class="h-12 w-auto object-contain"
      />
    </div>

    <h3 class="mt-5 font-bold text-gray-900">
      Český orienťák
    </h3>
  </a>

  <a
  href="https://www.rawet.cz/"
  target="_blank"
  rel="noopener noreferrer"
  class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-center"
>
  <div class="h-20 flex items-center justify-center">
    <img
      src="/images/partneri/rawet.jpg"
      alt="RAWET s.r.o."
      class="h-12 w-auto object-contain"
    />
  </div>

  <h3 class="mt-5 font-bold text-gray-900">
    RAWET s.r.o.
  </h3>
</a>

  <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm text-center">
    <div class="h-20 flex items-center justify-center text-gray-400">
      Logo partnera
    </div>
    <h3 class="mt-5 font-bold">Partner 3</h3>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm text-center">
    <div class="h-20 flex items-center justify-center text-gray-400">
      Logo partnera
    </div>
    <h3 class="mt-5 font-bold">Partner 4</h3>
  </div>

</div>
</MainLayout>