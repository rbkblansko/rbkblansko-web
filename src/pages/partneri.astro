---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Partneři">
  <div class="max-w-6xl mx-auto">

    <div class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">
        Partneři
      </h1>
      <div class="w-24 h-1.5 bg-brand mx-auto rounded-full"></div>

      <p class="text-xl text-gray-600 mt-8 max-w-3xl mx-auto">
        Děkujeme všem partnerům a podporovatelům,
        kteří pomáhají rozvíjet orientační běh v Blansku.
      </p>
    </div>

    <a
  href="https://www.ceskyorientak.cz/"
  target="_blank"
  rel="noopener noreferrer"
  class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 text-center flex flex-col justify-between"
>
  <div class="h-24 flex items-center justify-center">
    <img
      src="/images/partneri/cesky-orientak.png"
      alt="Český orienťák"
      class="max-h-20 w-auto object-contain"
    />
  </div>

  <h3 class="font-bold mt-6 text-gray-900">
    Český orienťák
  </h3>
</a>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm hover:shadow-md transition text-center">
        <div class="h-24 flex items-center justify-center text-gray-400">
          Logo partnera
        </div>
        <h3 class="font-bold mt-4">Partner 2</h3>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm hover:shadow-md transition text-center">
        <div class="h-24 flex items-center justify-center text-gray-400">
          Logo partnera
        </div>
        <h3 class="font-bold mt-4">Partner 3</h3>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm hover:shadow-md transition text-center">
        <div class="h-24 flex items-center justify-center text-gray-400">
          Logo partnera
        </div>
        <h3 class="font-bold mt-4">Partner 4</h3>
      </div>

    </div>

  </div>
</MainLayout>