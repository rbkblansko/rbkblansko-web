---
import MainLayout from '../layouts/MainLayout.astro';
import PartnerCard from '../components/PartnerCard.astro';
---

<MainLayout title="Partneři">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">
        Partneři
      </h1>
      <div class="w-24 h-1.5 bg-brand mx-auto rounded-full"></div>

      <p class="text-xl text-gray-600 mt-8 max-w-3xl mx-auto">
        Děkujeme všem partnerům a podporovatelům,
        kteří pomáhají rozvíjet orientační běh v Blansku.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <PartnerCard
        name="Český orienťák"
        logo="/images/partneri/cesky-orientak.png"
        url="https://www.ceskyorientak.cz/"
      />

      <PartnerCard
        name="RAWET s.r.o."
        logo="/images/partneri/rawet.jpg"
        url="https://www.rawet.cz/"
      />

      <PartnerCard
        name="Průmyslová keramika"
        logo="/images/partneri/prumker.jpg"
        url="https://prumyslova-keramika.cz/"
      />

      <PartnerCard
        name="Zdravé daně"
        logo="/images/partneri/zd.jpg"
        url="https://www.zdravedane.cz/"
      />
    </div>
  </div>
</MainLayout>