---
import { getPath } from '../utils/paths';

interface Props {
  title: string;
  date: Date;
  summary: string;
  slug: string;
}

const { title, date, summary, slug } = Astro.props;
---
<article class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col h-full group transform hover:-translate-y-1">
  <div class="h-2 w-full bg-gradient-to-r from-brand to-brand-light"></div>
  <div class="p-6 flex-grow flex flex-col">
    <time class="text-sm text-gray-400 mb-3 font-medium uppercase tracking-wider" datetime={date.toISOString()}>
      {date.toLocaleDateString('cs-CZ')}
    </time>
    <h3 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-brand transition-colors leading-tight">
      <a href={getPath(`/novinky/${slug}`)}>{title}</a>
    </h3>
    <p class="text-gray-600 flex-grow mb-6 leading-relaxed">{summary}</p>
    <a href={getPath(`/novinky/${slug}`)} class="inline-flex items-center text-brand font-semibold hover:text-brand-dark transition-colors mt-auto">
      Číst více
      <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>
