---
import { getPath } from '../utils/paths';
const year = new Date().getFullYear();
---

<footer class="relative text-gray-900 py-16 border-t-4 border-brand overflow-hidden">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${getPath('/images/footer-bg.jpg')}');`}
    aria-hidden="true"
  ></div>

  <div class="absolute inset-0 bg-white/45" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-xl font-bold mb-4 text-gray-900">RBK Blansko</h3>
        <p class="text-gray-700 leading-relaxed">Sportovní klub pro všechny, kteří milují pohyb a týmového ducha.</p>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-4 text-gray-900">Rychlé odkazy</h3>
        <ul class="space-y-2">
          <li><a href={getPath('/novinky')} class="text-gray-700 hover:text-brand transition-colors">Novinky</a></li>
          <li><a href={getPath('/program')} class="text-gray-700 hover:text-brand transition-colors">Program</a></li>
          <li><a href={getPath('/kalendar')} class="text-gray-700 hover:text-brand transition-colors">Kalendář</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-4 text-gray-900">Kontakt</h3>
        <p class="text-gray-700 mb-2">Email: <a href="mailto:jaroslavjalovy@email.cz" class="hover:text-brand transition-colors">jaroslavjalovy@email.cz</a></p>
        <p class="text-gray-700">Telefon: +420 123 456 789</p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-900/10 text-center text-gray-700 text-sm">
      <p>&copy; {year} RBK Blansko. Všechna práva vyhrazena.</p>
    </div>
  </div>
</footer>